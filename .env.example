# Postgres connection strings for Prisma (pooled + direct).
# This project is set up against a Supabase Postgres instance.
DATABASE_URL=
DIRECT_URL=

# Auth.js session encryption secret — generate with `npx auth secret`.
AUTH_SECRET=

# Google OAuth client credentials (Google Cloud Console).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Supabase project credentials.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
